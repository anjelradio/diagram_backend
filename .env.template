# ==============================================================================
# CONFIGURACIÓN DEL PROYECTO (Copia este archivo a .env)
# ==============================================================================

# Nombre del proyecto
PROJECT_NAME="FastAPI Scaffold"

# Entorno: DEV, STAGING, PROD
ENVIRONMENT=DEV

# ── Base de Datos ─────────────────────────────────────────────────────────────
# Por defecto SQLite local para desarrollo rápido sin dependencias.
# En producción o PostgreSQL remoto (ej. Neon / Railway / Supabase):
# postgresql://user:password@host:port/dbname
DATABASE_URL="sqlite:///./dev.db"

# Imprimir queries SQL en consola (True para depurar queries en local)
SQL_ECHO=False

# ── Better Auth & Seguridad ───────────────────────────────────────────────────
# URL del frontend (Next.js / SvelteKit / Nuxt) que gestiona Better Auth.
FRONTEND_URL="http://localhost:3000"

# Activar o desactivar verificación de roles de Better Auth:
# - True  (default): Espera que Better Auth emita el claim 'role' (requiere plugin 'admin').
# - False: Si tu frontend NO tiene el plugin 'admin' de Better Auth, ponlo en False.
#          El backend aceptará a cualquier usuario con JWT válido sin exigir roles.
BETTER_AUTH_ENABLE_ROLES=True

# URL directa al JWKS de Better Auth (opcional).
# Útil si FastAPI corre en Docker y accede al frontend por red interna (ej: http://frontend:3000/api/auth/jwks)
# mientras el navegador del usuario usa http://localhost:3000.
# Si se deja vacío o no se define, se usará {FRONTEND_URL}/api/auth/jwks automáticamente.
# BETTER_AUTH_JWKS_URL="http://host.docker.internal:3000/api/auth/jwks"

# Timeout en segundos para descargar claves públicas del JWKS
JWKS_TIMEOUT_SECONDS=5.0

# Clave secreta (mantenida por compatibilidad de webhooks internos si aplica)
BETTER_AUTH_SECRET="super-secret-key"

# Validaciones opcionales del JWT (déjalas vacías para omitir verificación estricta):
JWT_ISSUER=""
JWT_AUDIENCE=""

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por comas
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"